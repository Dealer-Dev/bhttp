[Unit]
Description=Servidor BHTTP Para Dealer VPN
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/bhttp/bhttp-server.py --host 0.0.0.0 --port 90 --backend-host 127.0.0.1 --backend-port 22
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
